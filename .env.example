# ==============================================================================
# Mẫu cấu hình môi trường cho Multilingual Dubbing Backend (.env.example)
# Sao chép file này thành .env: copy .env.example .env (Windows) hoặc cp .env.example .env (Linux/macOS)
# TUYỆT ĐỐI KHÔNG commit file .env thật chứa thông tin nhạy cảm vào Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. URL Nội Bộ Giữa Các Microservices (Docker Network Service Hostnames)
# ------------------------------------------------------------------------------
CONTENT_SERVICE_URL=http://content-service:8001
TTS_SERVICE_URL=http://translate-audio-service:8002

# ------------------------------------------------------------------------------
# 2. Timeout Cấu Hình (Đơn vị: Giây)
# ------------------------------------------------------------------------------
GATEWAY_TIMEOUT=6.0
TTS_TIMEOUT_SECONDS=10.0

# ------------------------------------------------------------------------------
# 3. Wikimedia API User-Agent (Bắt buộc theo Wikimedia User-Agent Policy)
# ------------------------------------------------------------------------------
WIKIMEDIA_USER_AGENT=multilingual-dubbing-backend/1.0 (contact: your-email@example.com)

# ------------------------------------------------------------------------------
# 4. Cache TTL & Phiên Bản Cache Nội Dung
# ------------------------------------------------------------------------------
# Thời hạn lưu trữ cache bài viết/thuyết minh trong SQLite của content-service (ngày)
NARRATION_TTL_DAYS=7
# Phiên bản cấu hình Edge TTS (thay đổi khi muốn làm mới toàn bộ cache file MP3)
TTS_CONFIG_VERSION=v1

# ------------------------------------------------------------------------------
# 5. Đường Dẫn Lưu Trữ Dữ Liệu Bền Vững (Persistence Volumes trong Container)
# ------------------------------------------------------------------------------
# Đường dẫn file SQLite của content-service (được ánh xạ vào named volume content_db_data)
DB_PATH=/app/data/content.db
# Thư mục lưu trữ file âm thanh MP3 (được ánh xạ vào named volume audio_cache_data)
AUDIO_DIR=/app/audio_files

# ------------------------------------------------------------------------------
# 6. Giọng Đọc Mặc Định Edge TTS (Microsoft Neural Voices)
# ------------------------------------------------------------------------------
TTS_VOICE_VI=vi-VN-HoaiMyNeural
TTS_VOICE_EN=en-US-JennyNeural
TTS_VOICE_JA=ja-JP-NanamiNeural

# ------------------------------------------------------------------------------
# 7. Cấu Hình Admin Dashboard & Bảo Mật (Tùy chỉnh riêng cho Quản trị viên)
# ------------------------------------------------------------------------------
# Đường dẫn URL quản trị riêng (khuyến nghị dùng chuỗi ngẫu nhiên, ví dụ: /admin-sec-9a8f2/)
ADMIN_PATH=/admin-dashboard/
# Tên đăng nhập quản trị
ADMIN_USERNAME=admin
# Mật khẩu quản trị (đặt chuỗi dài, mạnh, trên 12 ký tự)
ADMIN_PASSWORD=change-this-to-a-strong-secret-password
# Khóa bí mật ký session cookie HMAC-SHA256 (tạo bằng: python -c "import secrets; print(secrets.token_hex(32))")
ADMIN_SESSION_SECRET=change-this-to-a-64-character-random-hex-secret
# Đường dẫn database analytics
ANALYTICS_DB_PATH=/app/data/analytics.db

# 8. Luồng Wikimedia -> Gemini -> Edge TTS -> Supabase (chỉ Content Service đọc)
# Dùng connection string từ Supabase Connect > Session pooler, giữ sslmode=require.
# URL-encode ký tự đặc biệt trong mật khẩu; không dùng URL REST ở DATABASE_URL.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=YOUR_BACKEND_SECRET_KEY
SUPABASE_AUDIO_BUCKET=narration-audio
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.5-flash-lite
CONTENT_VERSION=v1
NARRATION_TARGET_CHARS=900
NARRATION_MAX_CONCURRENT=2
TTS_MAX_CONCURRENT=2
GATEWAY_NARRATE_TIMEOUT=15
# Tùy chọn: giọng đọc thêm (cấu hình giống nhau ở Content và TTS)
TTS_ALLOWED_VOICES_VI=vi-VN-NamMinhNeural
TTS_ALLOWED_VOICES_EN=en-US-GuyNeural
TTS_ALLOWED_VOICES_JA=ja-JP-KeitaNeural
