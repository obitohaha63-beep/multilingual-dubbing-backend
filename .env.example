# Mẫu cấu hình môi trường cho toàn bộ hệ thống Multilingual Dubbing Backend
# Copy file này thành .env ở thư mục gốc hoặc từng service nếu cần.

# Gateway Service configuration
CONTENT_SERVICE_URL=http://content-service:8001
TTS_SERVICE_URL=http://translate-audio-service:8002
GATEWAY_TIMEOUT=6.0

# Wikimedia API User-Agent (bắt buộc tuân thủ Wikimedia User-Agent policy)
# Thay your-email@example.com bằng thông tin liên hệ thật của bạn
WIKIMEDIA_USER_AGENT=multilingual-dubbing-backend/1.0 (contact: your-email@example.com)
