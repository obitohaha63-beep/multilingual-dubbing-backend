# ==============================================================================
# Mẫu cấu hình môi trường cho Multilingual Dubbing Backend (.env.example)
# Sao chép file này thành .env: copy .env.example .env (Windows) hoặc cp .env.example .env (Linux/macOS)
# TUYỆT ĐỐI KHÔNG commit file .env thật chứa thông tin nhạy cảm vào Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. URL Nội Bộ Giữa Các Microservices (Docker Network Service Hostnames)
# ------------------------------------------------------------------------------
CONTENT_SERVICE_URL=http://content-service:8001
TTS_SERVICE_URL=http://translate-audio-service:8002

# ------------------------------------------------------------------------------
# 2. Timeout Cấu Hình (Đơn vị: Giây)
# ------------------------------------------------------------------------------
GATEWAY_TIMEOUT=6.0
TTS_TIMEOUT_SECONDS=10.0

# ------------------------------------------------------------------------------
# 3. Wikimedia API User-Agent (Bắt buộc theo Wikimedia User-Agent Policy)
# ------------------------------------------------------------------------------
WIKIMEDIA_USER_AGENT=multilingual-dubbing-backend/1.0 (contact: your-email@example.com)

# ------------------------------------------------------------------------------
# 4. Cache TTL & Phiên Bản Cache Nội Dung
# ------------------------------------------------------------------------------
# Thời hạn lưu trữ cache bài viết/thuyết minh trong SQLite của content-service (ngày)
NARRATION_TTL_DAYS=7
# Phiên bản cấu hình Edge TTS (thay đổi khi muốn làm mới toàn bộ cache file MP3)
TTS_CONFIG_VERSION=v1

# ------------------------------------------------------------------------------
# 5. Đường Dẫn Lưu Trữ Dữ Liệu Bền Vững (Persistence Volumes trong Container)
# ------------------------------------------------------------------------------
# Đường dẫn file SQLite của content-service (được ánh xạ vào named volume content_db_data)
DB_PATH=/app/data/content.db
# Thư mục lưu trữ file âm thanh MP3 (được ánh xạ vào named volume audio_cache_data)
AUDIO_DIR=/app/audio_files

# ------------------------------------------------------------------------------
# 6. Giọng Đọc Mặc Định Edge TTS (Microsoft Neural Voices)
# ------------------------------------------------------------------------------
TTS_VOICE_VI=vi-VN-HoaiMyNeural
TTS_VOICE_EN=en-US-JennyNeural
TTS_VOICE_JA=ja-JP-NanamiNeural
